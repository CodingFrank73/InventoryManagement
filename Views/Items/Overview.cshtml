@model IEnumerable<Item>

<h1>Alle Items sollen angezeigt werden</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Produkt</th>
            <th>Stock</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Item item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Stock</td>
            </tr>
        }
    </tbody>
</table>